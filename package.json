{
  "name": "ai-it-support-agent-root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:backend": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 5001 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:electron": "electron electron/main.cjs",
    "dev": "concurrently -n \"BACKEND,FRONTEND,ELECTRON\" -c \"blue,green,yellow\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^43.2.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "lucide-react": "^1.27.0"
  }
}
