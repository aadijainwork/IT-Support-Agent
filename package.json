{
  "name": "ai-it-support-agent-root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:backend": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 5001 --reload",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}